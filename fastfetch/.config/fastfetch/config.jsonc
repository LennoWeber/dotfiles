{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "rhel_old",
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "color": {
      "keys": "#c7bfff",
      "output": "#e5e1ea",
      "separator": "#928f9d",
      "title": "#c8c1f0"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": " OS",
      "keyColor": "#c7bfff"
    },
    {
      "type": "host",
      "key": "󰌢 PC",
      "keyColor": "#ffade2"
    },
    {
      "type": "kernel",
      "key": " Kernel",
      "keyColor": "#c8c1f0"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "#ffb4ab"
    },
    {
      "type": "packages",
      "key": "󰏖 Pkgs",
      "keyColor": "#c7bfff"
    },
    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "#ffade2"
    },
    {
      "type": "wm",
      "key": " WM",
      "keyColor": "#c8c1f0"
    },
    {
      "type": "terminal",
      "key": " Term",
      "keyColor": "#c7bfff"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "#ffade2"
    },
    {
      "type": "memory",
      "key": " Mem",
      "keyColor": "#ffb4ab"
    },
    {
      "type": "battery",
      "key": "󰁹 Batt",
      "keyColor": "#c8c1f0"
    },
    "break",
    "colors"
  ]
}
