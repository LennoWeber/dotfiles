{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "rhel_old",
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "color": {
      "keys": "#b7cf8b",
      "output": "#e4e3db",
      "separator": "#8f9284",
      "title": "#c1cbaa"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": " OS",
      "keyColor": "#b7cf8b"
    },
    {
      "type": "host",
      "key": "󰌢 PC",
      "keyColor": "#92d4b5"
    },
    {
      "type": "kernel",
      "key": " Kernel",
      "keyColor": "#c1cbaa"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "#ffb4ab"
    },
    {
      "type": "packages",
      "key": "󰏖 Pkgs",
      "keyColor": "#b7cf8b"
    },
    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "#92d4b5"
    },
    {
      "type": "wm",
      "key": " WM",
      "keyColor": "#c1cbaa"
    },
    {
      "type": "terminal",
      "key": " Term",
      "keyColor": "#b7cf8b"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "#92d4b5"
    },
    {
      "type": "memory",
      "key": " Mem",
      "keyColor": "#ffb4ab"
    },
    {
      "type": "battery",
      "key": "󰁹 Batt",
      "keyColor": "#c1cbaa"
    },
    "break",
    "colors"
  ]
}
