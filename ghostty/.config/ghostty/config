# Ghostty – eingerichtet wie Terminal auf dem Mac.
# Alle Optionen: `ghostty +show-config --default --docs` oder https://ghostty.org/docs/config

# Farben kommen von der aktiven Shell (L-Shell bzw. Noctalia schreiben themes/noctalia und
# laden Ghostty neu, auch beim Wechsel zwischen Hell und Dunkel). Abstand um den Text setzt
# das L-Shell-Theme ebenfalls (10/6 px wie Terminal.app).
theme = noctalia

# Schrift wie Terminal.app: SF Mono, falls installiert, sonst Menlos Vorlage DejaVu Sans Mono
# (Menlo basiert darauf). Nerd-Font-Symbole (starship, eza) bringt Ghostty selbst mit.
font-family = "SF Mono"
font-family = "Menlo"
font-family = "DejaVu Sans Mono"
font-size = 12

# Blockcursor ohne Blinken, auch an der Eingabeaufforderung (Terminal.app-Standard).
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# Fenster: 80×24 Zeichen wie Terminal.app (gilt für schwebende Fenster), Titelleiste in der
# Farbe des Terminals mit Tabs oben, Ampel-Knöpfe kommen vom L-Shell-GTK-Theme.
window-width = 80
window-height = 24
window-theme = ghostty
# Hyprland zeichnet keine Titelleisten: Ghostty zeichnet seine eigene (mit Tabs und Ampel-Knöpfen).
window-decoration = client
gtk-titlebar = true
gtk-tabs-location = top
adw-toolbar-style = flat
window-new-tab-position = end

# Mauszeiger beim Tippen ausblenden, wie auf dem Mac.
mouse-hide-while-typing = true

# Eine laufende Instanz öffnet neue Fenster sofort (wie ein Mac-Programm, das im Dock bleibt).
gtk-single-instance = true

# Strg+C kopiert, wenn Text markiert ist, sonst bricht es ab (wie in deiner kitty-Config).
keybind = performable:ctrl+c=copy_to_clipboard

# Keine Rückfrage beim Schließen, keine Toasts für Kopieren/Neuladen.
confirm-close-surface = false
app-notifications = no-clipboard-copy,no-config-reload
