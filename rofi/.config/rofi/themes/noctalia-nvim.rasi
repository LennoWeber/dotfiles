* {
    bg: #111417ff;
    fg: #dce1e7ff;
    fg-dim: #99a3b0ff;
    prompt-fg: #7f8c99ff;
    accent: #6f9c93ff;
    select-bg: #1a1f24ff;
    select-fg: #dce1e7ff;

    font: "Google Sans Flex 9";
}

window {
    location: south west;
    anchor: south west;
    width: 100%;
    x-offset: 0px;
    y-offset: 0px;

    background-color: @bg;
    border: 0px;
    border-radius: 0px;

    padding: 0px;
    children: [mainbox];
}

mainbox {
    background-color: transparent;
    spacing: 0px;
    children: [listview, inputbar];
}

inputbar {
    background-color: @bg;
    spacing: 6px;
    padding: 0px 10px;
    margin: 0px;
    border: 0px;
    height: 21px;
    children: [textbox-prompt-colon, entry];
}

prompt {
    enabled: false;
    expand: false;
    str: ":";
    text-color: @prompt-fg;
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "command";
    placeholder-color: @fg-dim;
    padding: 0px;
    margin: 0px;
    cursor: text;
}

listview {
    background-color: transparent;
    enabled: true;
    require-input: true;
    dynamic: true;
    fixed-height: false;
    lines: 8;
    columns: 1;
    scrollbar: false;
    layout: vertical;
    spacing: 2px;
    padding: 6px 10px 4px 10px;
    border: 0px;
}

element {
    background-color: transparent;
    text-color: @fg-dim;
    border: 0px;
    border-radius: 0px;
    padding: 3px 8px;
    spacing: 8px;
    children: [element-icon, element-text];
}

element selected.normal {
    background-color: @select-bg;
    text-color: @select-fg;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: bold #6f9c93;
}

element-icon {
    background-color: transparent;
    size: 1.1em;
}

textbox-prompt-colon {
    enabled: true;
    expand: false;
    str: ":";
    background-color: transparent;
    padding: 0px;
    margin: 0px 6px 0px 0px;
    text-color: @prompt-fg;
}

mode-switcher {
    enabled: false;
}

message {
    enabled: false;
}
