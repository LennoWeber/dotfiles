/* Rofi colors — Generated from active Noctalia palette (m* tokens) */

* {
    /* was @theme "tokyo": fg0, cyan, red, blue */
    fg0: #859289ff;
    cyan: #d3c6aaff;
    red: #e67e80ff;
    blue: #a7c080ff;

    window-border: #a7c080ff;
    window-bg: #1e2326eb;
    mainbox-bg: #2d353bff;
    inputbar-bg: #a7c080ff;
    inputbar-border: #7a8478cc;
    list-bg: #2d353bff;
    element-bg: #2d353bff;
    select-bg: #a7c08038;
    message-border: #7a8478cc;
    message-bg: #1e2326e6;
}
