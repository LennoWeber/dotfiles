/* Rofi colors — Generated from active Noctalia palette (m* tokens) */

* {
    /* was @theme "tokyo": fg0, cyan, red, blue */
    fg0: #232a2eff;
    cyan: #232a2eff;
    red: #e66868ff;
    blue: #434f55ff;

    window-border: #434f55ff;
    window-bg: #efebd4eb;
    mainbox-bg: #bec5b2ff;
    inputbar-bg: #333c43ff;
    inputbar-border: #232a2ecc;
    list-bg: #bec5b2ff;
    element-bg: #bec5b2ff;
    select-bg: #434f5538;
    message-border: #232a2ecc;
    message-bg: #efebd4e6;
}
